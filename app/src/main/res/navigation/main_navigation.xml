<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
             xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_navigation"
    app:startDestination="@id/shoeFragment">

    <fragment
        android:id="@+id/shoeFragment"
        android:name="com.cart.kotlin_hoo_study.ui.fragment.main.ShoeFragment"
        android:label="shoe_fragment"
        tools:layout="@layout/shoe_fragment" >
        <action
            android:id="@+id/action_shoeFragment_to_shoeDetailFragment"
            app:destination="@id/shoeDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/favouriteFragment"
        android:name="com.cart.kotlin_hoo_study.ui.fragment.main.FavouriteFragment"
        android:label="favourite_fragment"
        tools:layout="@layout/favourite_fragment" />

    <fragment
        android:id="@+id/meFragment"
        android:name="com.cart.kotlin_hoo_study.ui.fragment.main.MeFragment"
        android:label="me_fragment"
        tools:layout="@layout/me_fragment" />

    <fragment
        android:id="@+id/shoeDetailFragment"
        android:name="com.cart.kotlin_hoo_study.ui.fragment.main.ShoeDetailFragment"
        android:label="shoe_detail_fragment"
        tools:layout="@layout/shoe_detail_fragment">
        <argument
            android:name="shoeId"
            app:argType="long" />
    </fragment>

</navigation>
<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <!-- ViewModel 数据绑定 -->
        <!--
            1. name="model"：在布局中使用 ${model.xxx} 访问 ViewModel 的属性
            2. type：指定 ViewModel 的全类名
        -->
        <variable
            name="registerModel"
            type="com.cart.kotlin_hoo_study.viewmodel.RegisterModel" />
        
        <!-- Activity 引用绑定，用于调用 Activity 的方法 -->
        <variable
            name="activity"
            type="androidx.fragment.app.FragmentActivity" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ui.fragment.login.RegisterFragment">

        <!-- 返回/取消按钮 -->
        <TextView
            android:id="@+id/tv_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="20dp"
            android:layout_marginStart="20dp"
            android:textSize="@dimen/txt_big_size"
            android:drawableStart="@drawable/common_ic_back"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:drawablePadding="10dp"
            android:text="Cancel"
            android:onClick="@{()->activity.onBackPressed()}"
            android:textColor="@color/colorPrimary" />

        <!-- 标题 -->
        <TextView
            android:id="@+id/tv_title"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintHorizontal_bias="0.1"
            app:layout_constraintVertical_bias="0.1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hey, Join us!"
            android:textColor="@color/textPrimary"
            android:padding="20dp"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- 邮箱输入框 -->
        <!--
            android:onTextChanged：文本变化监听
            语法：@{(text, start, before, count) -> model.onEmailChanged(text)}
            text 是 CharSequence 类型，ViewModel 方法接收后自动转换
        -->
        <EditText
            android:id="@+id/et_email"
            style="@style/CommonEditStyle"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"
            android:hint="email address"
            android:onTextChanged="@{(text, start, before, count)->registerModel.onEmailChanged(text)}"
            android:layout_marginBottom="20dp"
            android:drawableStart="@drawable/register_ic_email"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintBottom_toTopOf="@+id/et_account"
            android:text="@{registerModel.email}"
            tools:ignore="MissingConstraints" />

        <!-- 用户名输入框 -->
        <EditText
            android:id="@+id/et_account"
            style="@style/CommonEditStyle"
            app:layout_constraintVertical_bias="0.3"
            app:layout_constraintTop_toBottomOf="@+id/et_email"
            app:layout_constraintBottom_toTopOf="@+id/et_pwd"
            android:onTextChanged="@{(text, start, before, count)->registerModel.onAccountChanged(text)}"
            android:hint="account"
            android:drawableStart="@drawable/common_ic_account"
            android:text="@{registerModel.account}"
            tools:ignore="MissingConstraints" />

        <!-- 密码输入框 -->
        <EditText
            android:id="@+id/et_pwd"
            style="@style/CommonEditStyle"
            app:layout_constraintTop_toBottomOf="@+id/et_account"
            app:layout_constraintBottom_toTopOf="@+id/btn_register"
            android:layout_marginTop="20dp"
            android:inputType="textPassword"
            android:hint="password"
            android:onTextChanged="@{(text, start, before, count)->registerModel.onPwdChanged(text)}"
            android:drawableStart="@drawable/common_ic_pwd"
            android:text="@{registerModel.pwd}"
            tools:ignore="MissingConstraints" />

        <!-- 注册按钮 -->
        <!--
            android:enabled：绑定到 ViewModel 的 enable 属性
            当用户名、邮箱、密码都输入后，按钮自动变为可用状态
        -->
        <Button
            android:id="@+id/btn_register"
            style="@style/CommonButtonStyle"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.8"
            android:enabled="@{registerModel.enable}"
            android:text="Sign UP"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:ignore="MissingConstraints" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>

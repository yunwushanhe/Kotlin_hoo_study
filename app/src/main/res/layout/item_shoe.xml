<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <!--定义的这个 shoe 变量没有被用到，ImageView 与 TextView 的赋值是直接在
        ShoeAdapter 中的 onBindViewHolder 函数中的 bind 函数中实现的。应该也可以通过这里定义的 shoe 变量进行赋值实现-->
        <variable
            name="shoe"
            type="com.cart.kotlin_hoo_study.db.data.Shoe"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="4dp">

    <ImageView
        android:id="@+id/ivShoe"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/glide_placeholder"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/black_alpha_16"
        android:ellipsize="end"
        android:maxLines="1"
        android:padding="4dp"
        android:textColor="@color/textPrimary"
        android:textSize="@dimen/txt_small_size"
        app:layout_constraintBottom_toBottomOf="@id/ivShoe"
        app:layout_constraintEnd_toEndOf="@id/ivShoe"
        app:layout_constraintStart_toStartOf="@id/ivShoe"
        tools:text="Air Jordan 1"/>

</androidx.constraintlayout.widget.ConstraintLayout>
</layout>